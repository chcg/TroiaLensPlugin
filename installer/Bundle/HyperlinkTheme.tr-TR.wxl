  <String Id="InstallMessage" Value="[WixBundleName] Notepad++ eklentisi kurulacak. Eksikse .NET Framework 4.8, WebView2 ve Node.js da kurulur. Devam etmek için Kur'a, çıkmak için İptal'e tıklayın." />
